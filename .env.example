# Neon Postgres connection string (sslmode=require). Schema is created on
# first request — see src/server/db.ts.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs every JWT (HS256). Rotate it and every existing session is logged out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
