# Neon Postgres connection string (sslmode=require). Schema is created on
# first request — see src/server/db.ts.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs every JWT (HS256). Rotate it and every existing session is logged out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Bootstrap accounts, created ONLY if they do not exist yet (never re-hashed —
# admins reset passwords through the Users page).
# Format: username:password,username:password
AUTH_USERS=alice:change-me-please

# Comma-separated usernames that are admins. Authoritative; re-applied on
# every boot, so it survives a DB reset. Leave EMPTY to change nothing.
AUTH_ADMINS=alice

# Public address pasted into the "Login details" block an admin hands out.
# Falls back to window.location.origin when unset.
NEXT_PUBLIC_APP_URL=
